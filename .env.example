# Every variable is required; the server refuses to start without one.

# Where Bun listens. Keep HOST on loopback in production: nginx is the only way in.
PORT=3000
HOST=127.0.0.1

# The public origin (no path, no trailing slash). Also the only Origin a room socket
# is accepted from. Must be https when APP_ENV=production.
APP_URL=http://localhost:3000

# development | production. Never inferred: development serves Bun's verbose error page.
APP_ENV=development

DATABASE_PATH=data/musicplayer.db

# Discord application (https://discord.com/developers/applications → OAuth2).
# Register DISCORD_REDIRECT_URI there exactly; it must be on APP_URL's origin.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# The hosts: comma-separated Discord user ids (Discord → Settings → Advanced →
# Developer Mode, then right-click a user → Copy User ID). At least one. Hosts are
# always let in, and only they can open /admin to let other people in.
DISCORD_ALLOWED_USER_IDS=

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
# Restrict it to the YouTube Data API v3; restrict the production key to the server's IP.
YOUTUBE_API_KEY=

# Two-letter ISO 3166-1 region. Videos blocked here are refused when added.
YOUTUBE_REGION_CODE=EE
