{
  "name": "musicplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot musicplayer.ts",
    "start": "bun --smol musicplayer.ts",
    "build:client": "bun scripts/buildClient.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "measure": "bun scripts/measureResources.ts",
    "test": "bun test src scripts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-types": "^1.3.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.67.0"
  }
}
